generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Colaborador {
  id_colaborador Int         @id @default(autoincrement())
  nome           String      @db.VarChar(50)
  cpf            String      @unique @db.VarChar(14)
  email          String      @unique @db.VarChar(100)
  senha          String      @db.VarChar(255)
  data_admissao  DateTime    @db.Date
  cargo_atual    String      @db.VarChar(20)
  setor          String      @db.VarChar(20)
  matriculas     Matricula[]

  @@index([nome])
  @@map("colaboradores")
}

model Curso {
  id_curso               Int         @id @default(autoincrement())
  titulo                  String      @db.VarChar(100)
  conteudo_programatico   String      @db.VarChar(500)
  area_conhecimento       String      @db.VarChar(50)
  carga_horaria           Int
  descricao               String      @db.VarChar(500)
  matriculas              Matricula[]

  @@index([titulo])
  @@index([area_conhecimento])
  @@map("cursos")
}

model Certificado {
  id_certificado      Int        @id @default(autoincrement())
  codigo_autenticacao String     @unique @db.VarChar(50)
  data_emissao        DateTime   @db.Date
  data_validade       DateTime   @db.Date
  url_documento       String     @db.VarChar(255)
  matricula           Matricula?

  @@index([data_emissao])
  @@map("certificados")
}

model Matricula {
  id_matricula    Int          @id @default(autoincrement())
  data_matricula  DateTime     @db.Date
  data_conclusao  DateTime?    @db.Date
  situacao        String       @db.VarChar(20)
  progresso       Float        @default(0)
  id_colaborador  Int
  id_curso        Int
  id_certificado  Int?         @unique

  colaborador     Colaborador  @relation(fields: [id_colaborador], references: [id_colaborador], onDelete: Restrict, onUpdate: Cascade)
  curso           Curso        @relation(fields: [id_curso], references: [id_curso], onDelete: Restrict, onUpdate: Cascade)
  certificado     Certificado? @relation(fields: [id_certificado], references: [id_certificado], onDelete: SetNull, onUpdate: Cascade)

  @@index([id_colaborador])
  @@index([id_curso])
  @@index([situacao])
  @@map("matriculas")
}
